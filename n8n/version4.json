    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// convert both to YYYY-MM-DD (pure date, no timezone)\nconst todayStr = new Date().toISOString().split(\"T\")[0];\nconst leaveStr = $json.leave_start.split(\"T\")[0];\nconst createdStr = $json.created_at.split(\"T\")[0];\n\n// convert back to Date (safe, no timezone shift)\nconst today = new Date(todayStr);\nconst leaveStart = new Date(leaveStr);\nconst createdAt = new Date(createdStr);\n\n// calculate diff\nconst diffTime = leaveStart.getTime() - today.getTime();\nconst diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\nlet actionType = $json.current_step;\n\n// AUTO APPROVE (today or past)\nif (  createdAt > leaveStart && diffDays === 0 && $json.status === \"pending\") {\n  actionType = \"auto_approve\";\n}\n\n// ESCALATE (within 5 days)\nelse if (diffDays <= 5 && diffDays > 0 && $json.current_step === \"DM\") {\n  actionType = \"RM\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    actionType,\n    diffDays,\n    todayStr,\n    leaveStr\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
