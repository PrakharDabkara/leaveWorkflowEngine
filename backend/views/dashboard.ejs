<h2>Workflow Dashboard</h2>

<table border="1" cellpadding="10">
  <tr>
    <th>ID</th>
    <th>Employee</th>
    <th>Status</th>
    <th>Step</th>
    <th>Action</th>
  </tr>

  <% requests.forEach(r => { %>
    <tr>
      <td><%= r.id %></td>
      <td><%= r.name %></td>
      <td><%= r.status %></td>
      <td><%= r.current_step %></td>
      <td>
        <a href="/api/requests/<%= r.id %>/view">View</a>
      </td>
    </tr>
  <% }) %>
</table>